{
  "name": "@tequity/tequity-infra",
  "version": "0.1.0",
  "description": "Tequity infrastructure — Pulumi (k8s cluster deps, per-project Vault, observability stack, policy-as-code).",
  "license": "UNLICENSED",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run --globals",
    "audit:dependencies": "npm audit --audit-level=high",
    "test:dependencies": "node scripts/dependency-smoke.cjs",
    "scan:secrets": "node scripts/secret-scan.cjs",
    "preview:offline": "vitest run --globals test/*-offline-preview.test.ts",
    "preview": "pulumi preview",
    "up": "pulumi up"
  },
  "dependencies": {
    "@pulumi/kubernetes": "^4.18.0",
    "@pulumi/pulumi": "^3.140.0",
    "@pulumi/vault": "7.9.0"
  },
  "optionalDependencies": {
    "@pulumi/gcp": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@pulumi/gcp": {
      "@npmcli/package-json": "7.0.5"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
